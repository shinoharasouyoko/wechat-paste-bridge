{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeChat Paste Bridge",
  "version": "1.0.0",
  "identifier": "local.codex.wechatpastebridge",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "WeChat Paste Bridge", "width": 1200, "height": 820, "resizable": true }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "nsis", "icon": ["brand-icons/icon.ico"], "windows": { "nsis": { "displayLanguageSelector": false, "installerIcon": "brand-icons/icon.ico" } } }
}
